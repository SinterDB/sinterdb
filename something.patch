+++ b/apps/website/src/app/docs/(guides)/documents/page.mdx
@@ -0,0 +1,85 @@
+export const metadata = {
+  title: "Documents",
+  description:
+    "The values a document can hold, how _id works, and the limits on document size and shape.",
+};
+
+# Documents
+
+A document is a plain JavaScript object. SinterDB stores it in a compact binary form and returns it as an object again, with the same value types.
+
+## Supported values
+
+| Value        | Example                         |
+| ------------ | ------------------------------- |
+| `null`       | `null`                          |
+| Boolean      | `true`                          |
+| Number       | `42`, `3.14`, `NaN`, `Infinity` |
+| `bigint`     | `9007199254740993n`             |
+| String       | `"hello"`                       |
+| `Date`       | `new Date()`                    |
+| `Uint8Array` | `new Uint8Array([1, 2, 3])`     |
+| `CustomId`   | `CustomId.generate()`           |
+| Array        | `[1, "two", { three: 3 }]`      |
+| Plain object | `{ city: "Paris" }`             |
+
+Anything else is rejected before it is sent, with a <Api name="SinterDocumentError" />. That includes `undefined`, functions, symbols, and class instances such as `Map` and `Set`.
+
+<Callout title="Leave fields out instead of using undefined" tone="warning">
+  `{ nickname: undefined }` is an error, not a missing field. Omit the field, or set it to `null` if you want it present but empty.
+</Callout>
+
+## The `_id` field
+
+Every document has an `_id`, and it is always a <Api name="CustomId" />. If you insert a document without one, the server generates it.
+
+```ts
+import { CustomId } from "sinterdb";
+
+const { insertedId } = await users.insertOne({ name: "Kage" });
+insertedId.toHexString(); // "6710f3c2..."
+insertedId.timestamp; // when it was generated
+
+const id = CustomId.generate();
+await users.insertOne({ _id: id, name: "Rin" });
+
+const same = CustomId.fromHexString(id.toHexString());
+same.equals(id); // true
+```
+
+- Plain strings and numbers are not accepted as `_id`.
+- `_id` cannot be changed after insert.
+- Compare ids with `equals()`, not `===`, since two `CustomId` objects with the same value are different objects.
+
+In TypeScript, <Api name="OptionalId" /> is the shape you insert (with `_id` optional) and <Api name="WithId" /> is the shape you read back (with `_id` always present).
+
+## How values are compared
+
+Values are compared by their stored form, so a few pairs that look alike are different:
+
+- `1` and `1n` are different values, because a number and a bigint are stored differently.
+- `0` and `-0` are different under equality, but equal in ranges and sorting. Avoid storing `-0`.
+- A field set to `null` is not the same as a missing field.
+
+The [Filters](/docs/filters) page covers what this means for queries.
+
+## Field order
+
+Fields come back sorted by name, not in the order you wrote them:
+
+```ts
+await users.insertOne({ name: "Kage", age: 30 });
+await users.findOne({ name: "Kage" });
+// { _id: ..., age: 30, name: "Kage" }
+```
+
+Arrays keep their order. Don't depend on the order of an object's keys.
+
+## Limits
+
+| What                      | Limit                                       |
+| ------------------------- | ------------------------------------------- |
+| One request or response   | 16 MiB, including every document it carries |
+| Nesting inside a document | 98 levels of documents inside the document  |
+
+Keep documents far below 16 MiB. A query result is split into batches automatically, but a single document has to fit in one message.
diff --git a/apps/website/src/app/docs/(guides)/filters/page.mdx b/apps/website/src/app/docs/(guides)/filters/page.mdx
new file mode 100644
index 0000000..a4fc6e6
--- /dev/null
+++ b/apps/website/src/app/docs/(guides)/filters/page.mdx
@@ -0,0 +1,115 @@
+export const metadata = {
+  title: "Filters",
+  description:
+    "Match documents by equality, comparison, logic, nested fields, and array contents.",
+};
+
+# Filters
+
+A filter chooses documents. `find`, `findOne`, `countDocuments`, `distinct`, updates and deletes all take one, and they all match documents the same way.
+
+## Equality
+
+A filter is an object of fields and values. A document matches when every field equals its value.
+
+```ts
+await users.find({ name: "Kage", age: 30 }).toArray();
+await users.find({}).toArray(); // every document
+```
+
+Equality is exact, so values must have the same type: `{ age: 30 }` does not match `"30"`, and `1` does not match `1n`. Nested objects match when they have the same fields with equal values, in any key order.
+
+## Comparison operators
+
+| Operator      | Matches when the field…                  |
+| ------------- | ---------------------------------------- |
+| `$eq`         | equals the value                         |
+| `$ne`         | does not equal the value, or is missing  |
+| `$gt`, `$gte` | is greater than (or equal to) the value  |
+| `$lt`, `$lte` | is less than (or equal to) the value     |
+| `$in`         | equals any value in the list             |
+| `$nin`        | equals none of the values, or is missing |
+| `$exists`     | is present (`true`) or missing (`false`) |
+
+```ts
+await users.find({ age: { $gte: 18, $lt: 65 } }).toArray();
+await users.find({ role: { $in: ["admin", "owner"] } }).toArray();
+await users.find({ deletedAt: { $exists: false } }).toArray();
+```
+
+Range operators only compare values of the same type. `{ age: { $gt: 18 } }` never matches a string, and a number never matches a bigint. Strings compare by Unicode code point, with no case folding: `"B"` comes before `"a"`.
+
+<Callout title="null is not missing" tone="neutral">
+  `{ nickname: null }` matches only documents where `nickname` is set to `null`. Use `{ nickname: { $exists: false } }` for documents without the field.
+</Callout>
+
+## Combining conditions
+
+Fields in one filter are joined by AND. For anything else, use the logical operators:
+
+```ts
+await users
+  .find({
+    $or: [{ role: "admin" }, { age: { $gte: 65 } }],
+  })
+  .toArray();
+
+await users.find({ age: { $not: { $gte: 18 } } }).toArray();
+```
+
+| Operator | Matches when                                       |
+| -------- | -------------------------------------------------- |
+| `$and`   | every filter in the list matches                   |
+| `$or`    | at least one filter matches                        |
+| `$nor`   | no filter matches                                  |
+| `$not`   | the field does not satisfy the operators inside it |
+
+`$and`, `$or` and `$nor` take a non-empty array. `$not` also matches a missing field, or one of another type, since the operator inside didn't match it.
+
+## Nested fields
+
+A dotted path reaches into nested documents:
+
+```ts
+await users.find({ "address.city": "Paris" }).toArray();
+```
+
+A path through something that isn't a document doesn't match. TypeScript checks dotted paths against your document type, so a typo is a compile error.
+
+## Arrays
+
+A filter on an array field looks at the array's elements as well as the array itself:
+
+```ts
+// tags: ["admin", "beta"]
+await users.find({ tags: "admin" }).toArray(); // matches: one element is "admin"
+await users.find({ tags: ["admin", "beta"] }).toArray(); // matches: the exact array
+await users.find({ scores: { $gt: 90 } }).toArray(); // any element above 90
+```
+
+Each condition on an array is checked on its own. `{ scores: { $gt: 90, $lt: 95 } }` matches `[80, 99]`, because one element is above 90 and another is below 95. To require one element to meet every condition, use `$elemMatch`:
+
+```ts
+await users.find({ scores: { $elemMatch: { $gt: 90, $lt: 95 } } }).toArray();
+
+await orders
+  .find({
+    items: { $elemMatch: { sku: "a-1", qty: { $gte: 2 } } },
+  })
+  .toArray();
+```
+
+| Operator     | Matches when                                    |
+| ------------ | ----------------------------------------------- |
+| `$elemMatch` | one element satisfies every condition inside it |
+| `$size`      | the array has exactly this many elements        |
+
+Paths step through arrays too. `"items.sku"` checks the `sku` of every element, and a number picks one position: `"items.0.sku"` is the first item's `sku`.
+
+`$ne` and `$nin` are the exact opposites of `$eq` and `$in`, so `{ tags: { $ne: "admin" } }` does **not** match `["admin", "beta"]`.
+
+## Not supported yet
+
+`$regex`, `$all`, `$type`, `$mod`, `$expr`, `$text` and `$where` are rejected by the server. There is no full-text or geospatial search.
+
+The complete matching rules, with a tested example for each case, are in [query-semantics.md](https://github.com/SinterDB/sinterdb/blob/main/docs/query-semantics.md). The filter types are <Api name="Filter" /> and <Api name="FilterOperators" />.
diff --git a/apps/website/src/app/docs/(guides)/inserts/page.mdx b/apps/website/src/app/docs/(guides)/inserts/page.mdx
new file mode 100644
index 0000000..17c1609
--- /dev/null
+++ b/apps/website/src/app/docs/(guides)/inserts/page.mdx
@@ -0,0 +1,91 @@
+export const metadata = {
+  title: "Inserts",
+  description:
+    "Insert one or many documents, get their ids back, and handle duplicate keys and partial failures.",
+};
+
+# Inserts
+
+Inserting creates the database and collection if they don't exist yet.
+
+## Insert one document
+
+```ts
+const result = await users.insertOne({
+  email: "kage@example.com",
+  name: "Kage",
+  age: 30,
+});
+
+result.insertedId; // the new document's _id
+```
+
+If the document has no `_id`, the server generates one and returns it in `insertedId`. To choose the id yourself, pass a <Api name="CustomId" />:
+
+```ts
+import { CustomId } from "sinterdb";
+
+await users.insertOne({ _id: CustomId.generate(), name: "Rin" });
+```
+
+## Insert many documents
+
+```ts
+const result = await users.insertMany([
+  { name: "Rin", age: 22 },
+  { name: "Sora", age: 41 },
+]);
+
+result.insertedCount; // 2
+result.insertedIds; // one _id per document, in input order
+```
+
+Documents are inserted in order. An empty array is rejected.
+
+## When an insert fails
+
+Inserting a document whose `_id`, or a value in a unique index, already exists fails with a <Api name="SinterServerError" /> named `DuplicateKey`:
+
+```ts
+import { SinterServerError } from "sinterdb";
+
+try {
+  await users.insertOne({ email: "kage@example.com", name: "Kage again" });
+} catch (error) {
+  if (
+    error instanceof SinterServerError &&
+    error.serverErrorName === "DuplicateKey"
+  ) {
+    // That email is taken
+  }
+}
+```
+
+`insertMany` stops at the first document that fails. The documents before it **stay inserted**, and the error is a <Api name="SinterInsertManyError" /> that says how far it got:
+
+```ts
+import { SinterInsertManyError } from "sinterdb";
+
+try {
+  await users.insertMany(newUsers);
+} catch (error) {
+  if (error instanceof SinterInsertManyError) {
+    error.failedIndex; // position of the document that failed
+    error.insertedIds; // ids of the documents inserted before it
+  }
+}
+```
+
+There are no transactions yet, so to make a batch all-or-nothing you have to remove the inserted documents yourself.
+
+## Invalid documents
+
+A document with a value SinterDB can't store, such as `undefined`, a function or a `Map`, fails before anything is sent, with a <Api name="SinterDocumentError" />. See [Documents](/docs/documents#supported-values) for what can be stored.
+
+## Size
+
+A whole request is limited to 16 MiB, so all the documents in one `insertMany` have to fit together. Insert large sets in several calls.
+
+## When is it saved?
+
+An insert resolves when the server acknowledges it, and the server's write concern decides when that is. With the default, `flushed`, the data is on stable storage by then and survives a crash or power loss. Faster levels exist for data you can recreate. See [configuration.md](https://github.com/SinterDB/sinterdb/blob/main/docs/configuration.md#write-concern).
