{
  "$schema": "https://sinterdb.vercel.app/typedoc/react-output/schema.json",
  "name": "SinterDB driver API",
  "entryPoints": ["../../packages/driver/dist/index.d.ts"],
  "tsconfig": "./tsconfig.json",
  "plugin": ["@sinterdb/typedoc-react-output"],
  "outputs": [
    {
      "name": "html",
      "path": "../../docs/api/static"
    },
    {
      "name": "react",
      "path": "../../docs/api/react"
    },
    {
      "name": "react",
      "path": "../../apps/website/src/app/docs/api"
    }
  ],
  "reactOutput": {
    "framework": "next",
    "routeBase": "/docs/api",
    "cleanOutput": true,
    "generated": {
      "directory": "_generated"
    },
    "components": {
      "directory": "_components",
      "overrides": "../../apps/website/src/api-theme"
    },
    "declarations": {
      "enabled": true,
      "directory": "_types",
      "moduleName": null
    },
    "features": {
      "hierarchy": true,
      "navigation": true,
      "pageNavigation": true,
      "sourceLinks": true,
      "comments": true,
      "externalInherited": false
    },
    "theme": {
      "name": "default",
      "colorScheme": "dark"
    }
  },
  "readme": "none",
  "maxTypeConversionDepth": 20,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "githubPages": false
}
