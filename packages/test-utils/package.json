{
  "name": "@sinterdb-internal/test-utils",
  "version": "0.3.0",
  "private": true,
  "description": "Internal test utilities and fixtures for SinterDB.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@sinterdb-internal/server": "workspace:^"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
